PORT=3000

# When running inside Docker (service name "mongo" resolves via Docker network)
MONGO_URI=mongodb://admin:password@mongo:27017/habitflow?authSource=admin

# When running the backend locally against a Docker MongoDB, use localhost instead:
# MONGO_URI=mongodb://admin:password@localhost:27017/habitflow?authSource=admin

GEMINI_API_KEY=your_gemini_api_key
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
